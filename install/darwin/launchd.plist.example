<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Grok Build Remote — launchd agent example (macOS)

  Binary: gbr-agent
  Install binary first (e.g. ~/.local/bin/gbr-agent via install/install.sh)

  Setup:
    1. Copy to ~/Library/LaunchAgents/com.linespotting.gbr-agent.plist
    2. Edit ProgramArguments[0] if your install path differs
    3. mkdir -p ~/Library/Logs/GrokBuildRemote
    Supported NI install: scripts/darwin/install-service.sh
    (halt + no-auto-open + Background ProcessType; do not use Interactive).
    4. Prefer: scripts/darwin/install-service.sh   # no start
       scripts/darwin/install-service.sh --start   # David yes
    Legacy Interactive example used com.linespotting.gbr-agent — disable, do not delete.

  Unload:
    launchctl unload ~/Library/LaunchAgents/com.linespotting.gbr-agent.plist

  Notes:
    - Use LaunchAgents (user session), not LaunchDaemons, so AppleScript /
      Accessibility inject can reach interactive terminals.
    - Login Items / System Settings show **Grok Build Remote** via
      AssociatedBundleIdentifiers → com.linespotting.grok-build-remote
      (app bundle: install/darwin/Grok Build Remote.app; CFBundleDisplayName).
      `gbr-agent service install` copies that bundle to ~/Applications.
    - Grant Accessibility / Automation permissions to the **gbr-agent** binary
      when prompted (the app stub execs that binary; the grant path is the CLI).
    - Grok API key: ~/.grok/config.json
    - Protocol: gbr/1
    - CLI command stays gbr-agent; env vars stay GBR_*.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.linespotting.grok-build-remote</string>

    <key>AssociatedBundleIdentifiers</key>
    <array>
      <string>com.linespotting.grok-build-remote</string>
    </array>

    <key>ProgramArguments</key>
    <array>
      <string>/Users/REPLACE_ME/.local/bin/gbr-agent</string>
      <string>-log=info</string>
      <string>run</string>
      <string>-inject-halt</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
      <key>SuccessfulExit</key>
      <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>WorkingDirectory</key>
    <string>/Users/REPLACE_ME</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>GBR_DATA_DIR</key>
      <string>/Users/REPLACE_ME/Library/Application Support/GrokBuildRemote</string>
      <key>GBR_LOG_DIR</key>
      <string>/Users/REPLACE_ME/pc-build/gbr-agent-out</string>
      <key>GBR_INJECT_HALT</key>
      <string>1</string>
      <key>GBR_NO_AUTO_OPEN</key>
      <string>1</string>
      <key>GBR_INBOX_WATCH</key>
      <string>0</string>
      <key>PATH</key>
      <string>/usr/local/bin:/usr/bin:/bin:/Users/REPLACE_ME/.local/bin</string>
      <!-- Hub PCs: uncomment to require mailbox key on loopback Bot API.
      <key>GBR_BOT_REQUIRE_KEY</key>
      <string>1</string>
      -->
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/REPLACE_ME/Library/Logs/GrokBuildRemote/gbr-agent.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/REPLACE_ME/Library/Logs/GrokBuildRemote/gbr-agent.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
  </dict>
</plist>
