{
  "name": "build-remote-agent",
  "description": "Installable pairing plugins for Build Remote Agent. Protocol gbr/1. We do not ship vendor copy into other people's official examples.",
  "homepage": "https://grokbuildremote.com/integrations.html",
  "owner": "Linespotting AB",
  "version": "0.6.1",
  "plugins": [
    {
      "id": "gbr-mcp",
      "kind": "mcp-stdio",
      "path": "mcp/gbr-mcp",
      "skill": "skills/gbr-mcp/SKILL.md",
      "pin": "git clone --branch v0.6.0 --depth 1",
      "attach": "127.0.0.1:8788 after gbr-agent run",
      "auth": "loopback unauthenticated unless GBR_BOT_REQUIRE_KEY=1; relay always X-GBR-Key",
      "phone": "terminals discovered on the PC, not this MCP client"
    },
    {
      "id": "gbr-mcp-skill",
      "kind": "skill",
      "path": "skills/gbr-mcp/SKILL.md",
      "also": "mcp/gbr-mcp/SKILL.md",
      "pin": "v0.6.0",
      "install": "git clone --branch v0.6.0 --depth 1; npm install in mcp/gbr-mcp"
    },
    {
      "id": "grok-build",
      "kind": "grok-plugin",
      "path": ".grok-plugin/plugin.json",
      "install": "/plugin marketplace add LinespottingOrg/GrokBuildRemote-Agents"
    },
    {
      "id": "claude-code",
      "kind": "claude-plugin",
      "path": ".claude-plugin/plugin.json",
      "install": "/plugin marketplace add LinespottingOrg/GrokBuildRemote-Agents"
    },
    {
      "id": "opencode-mcp",
      "kind": "opencode-v2-mcp.servers",
      "path": "plugins/opencode/mcp.servers.json",
      "phone": "only if OpenCode runs in a terminal window; headless serve is not a TTY"
    },
    {
      "id": "aider-desk",
      "kind": "aider-desk-extension",
      "path": "plugins/aider-desk",
      "install": "copy to ~/.aider-desk/extensions/gbr-pair"
    },
    {
      "id": "codex-plugin-manifest",
      "kind": "codex-plugin",
      "path": ".codex-plugin/plugin.json"
    }
  ]
}
