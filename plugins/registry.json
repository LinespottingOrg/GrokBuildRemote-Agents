{
  "name": "build-remote-agent",
  "description": "Installable pairing plugins for Build Remote Agent. Protocol gbr/1. We do not ship vendor copy into other people's official examples.",
  "homepage": "https://grokbuildremote.com/integrations.html",
  "owner": "Linespotting AB",
  "version": "0.6.1",
  "plugins": [
    {
      "id": "gbr-mcp",
      "kind": "mcp-stdio",
      "path": "mcp/gbr-mcp",
      "skill": "skills/gbr-mcp/SKILL.md",
      "pin": "git clone --branch v0.6.2 --depth 1",
      "attach": "127.0.0.1:8788 after gbr-agent run",
      "phone": "terminals discovered on the PC, not this MCP client"
    },
    {
      "id": "grok-build",
      "kind": "grok-plugin",
      "path": ".grok-plugin/plugin.json",
      "install": "/plugin marketplace add LinespottingOrg/GrokBuildRemote-Agents"
    },
    {
      "id": "claude-code",
      "kind": "claude-plugin",
      "path": ".claude-plugin/plugin.json",
      "install": "/plugin marketplace add LinespottingOrg/GrokBuildRemote-Agents"
    },
    {
      "id": "opencode-mcp",
      "kind": "opencode-v2-mcp.servers",
      "path": "plugins/opencode/mcp.servers.json",
      "phone": "only if OpenCode runs in a terminal window; headless serve is not a TTY"
    },
    {
      "id": "aider-desk",
      "kind": "aider-desk-extension",
      "path": "plugins/aider-desk",
      "install": "copy to ~/.aider-desk/extensions/gbr-pair"
    },
    {
      "id": "codex-plugin-manifest",
      "kind": "codex-plugin",
      "path": ".codex-plugin/plugin.json",
      "role": "scanner-ready-catalog",
      "core": false,
      "not": "openai/codex",
      "howto": "plugins/codex/README.md",
      "pin": "v0.6.2"
    },
    {
      "id": "goose-skill",
      "kind": "skill",
      "path": "skills/goose/SKILL.md",
      "phone": "Goose CLI in a TTY; else gbr-mcp on desktop Goose. Not a PR into block/goose."
    },
    {
      "id": "cline-skill",
      "kind": "skill",
      "path": "skills/cline/SKILL.md",
      "phone": "Cline CLI in a TTY; else gbr-mcp on desktop Cline. Not a PR into cline/cline."
    },
    {
      "id": "gbr-mcp-skill",
      "kind": "skill",
      "path": "skills/gbr-mcp/SKILL.md",
      "pin": "v0.6.2",
      "install": "git clone --branch v0.6.2 --depth 1; npm install in mcp/gbr-mcp"
    },
    {
      "id": "hermes-mcp",
      "kind": "hermes-mcp",
      "path": "plugins/hermes/mcp.json",
      "install": "scripts/setup-gbr-mcp.sh then hermes mcp add gbr stdio",
      "target": "gbr_open spawns grok CLI"
    },
    {
      "id": "openclaw-mcp",
      "kind": "openclaw-mcp",
      "path": "plugins/openclaw/mcp.json",
      "skill": "skills/openclaw/SKILL.md"
    },
    {
      "id": "nemoclaw-host-mcp",
      "kind": "nemoclaw-host-mcp",
      "path": "plugins/nemoclaw/mcp.json",
      "note": "host only — not inside OpenShell"
    },
    {
      "id": "multi-agent-qa",
      "kind": "skill",
      "path": "skills/qa/SKILL.md",
      "docs": "docs/USE-CASE-MULTI-AGENT-QA.md",
      "note": "Grok multi-agent QA until gbr_tasks done. Agent+relay free. Pin v0.6.2."
    }
  ]
}
